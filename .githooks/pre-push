#!/usr/bin/env bash
# Pre-push local build/test gate for sumit.
# Per local clone: git config --local core.hooksPath .githooks
set -Eeuo pipefail
cd "$(git rev-parse --show-toplevel)"
echo "[local-gate] sumit: checking before push..."
if git rev-parse HEAD^ >/dev/null 2>&1; then git diff --check HEAD^ HEAD; fi
command -v dotnet >/dev/null || { echo 'dotnet SDK required' >&2; exit 1; }
dotnet restore Sumit.TransactionExporter.sln
dotnet build Sumit.TransactionExporter.sln -c Release --no-restore
dotnet test Sumit.TransactionExporter.sln -c Release --no-build
echo "[local-gate] sumit: PASS (only for checks actually executed)."
